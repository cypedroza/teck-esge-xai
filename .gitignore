# ═══════════════════════════════════════════════════════════════════════════
# IMPORTANT: Files TO KEEP in version control
# ═══════════════════════════════════════════════════════════════════════════
# ✅ README.md
# ✅ requirements.txt
# ✅ LICENSE
# ✅ .gitignore
# ✅ All .py files in src/
# ✅ All .ipynb files in notebooks/ (with outputs cleared)
# ✅ docs/ folder
# ✅ tests/ folder
# ═══════════════════════════════════════════════════════════════════════════

# Keep empty directories
!data/raw/.gitkeep
!data/processed/.gitkeep
!outputs/figures/.gitkeep
!outputs/tables/.gitkeep
!outputs/models/.gitkeep
!outputs/logs/.gitkeep
!powerbi_data/.gitkeep
