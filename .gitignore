.ipynb_checkpoints
*/.ipynb_checkpoints/*
profile_default/
ipython_config.py

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Data Files (IMPORTANTE: Não versionar dados sensíveis)
data/raw/*.pdf
data/raw/*.csv
data/processed/*.csv
data/processed/*.parquet
*.xlsx
*.xls

# Outputs (Não versionar resultados)
outputs/figures/*.png
outputs/figures/*.jpg
outputs/tables/*.csv
outputs/models/*.pkl
outputs/models/*.joblib
outputs/logs/*.log
outputs/logs/*.txt

# Power BI
powerbi_data/*.csv
*.pbix

